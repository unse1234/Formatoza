{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "converter-site-kit",
    "test-results",
    "playwright-report",
    "public"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["vite/client"],
    "noPropertyAccessFromIndexSignature": false
  }
}
