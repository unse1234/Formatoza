# Canonical origin used for canonical URLs, sitemap and Open Graph. No trailing slash.
PUBLIC_SITE_URL=https://formatoza.com

# Public contact address shown on /contact and in the footer.
PUBLIC_CONTACT_EMAIL=hello@formatoza.com

# --- Google AdSense (leave empty until the site is approved) ---
# Publisher ID, e.g. ca-pub-0000000000000000. When empty, no ad code is emitted at all.
PUBLIC_ADSENSE_CLIENT=
# Ad unit (slot) IDs created in the AdSense UI. Empty slot = that placement renders nothing.
PUBLIC_ADSENSE_SLOT_TOOL_AFTER_CONVERTER=
PUBLIC_ADSENSE_SLOT_TOOL_IN_CONTENT=
PUBLIC_ADSENSE_SLOT_GUIDE_IN_CONTENT=
# Show labelled grey placeholder boxes where ads will go (local design review only).
PUBLIC_AD_PLACEHOLDERS=false

# --- Optional, cookieless analytics ---
# Cloudflare Web Analytics beacon token. Page views only; no file data is ever sent.
PUBLIC_CF_BEACON_TOKEN=
