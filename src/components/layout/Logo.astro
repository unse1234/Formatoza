---
interface Props {
  class?: string;
  href?: string;
  label?: string;
}
const { href = '/', label = 'Formatoza home' } = Astro.props;
---

<a
  href={href}
  class:list={['group inline-flex items-center gap-2 rounded-sm', Astro.props.class]}
  aria-label={label}
>
  <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
    <rect width="32" height="32" rx="7" fill="currentColor"></rect>
    <path
      d="M9.5 9h13M9.5 16h7.5M9.5 9v14"
      stroke="var(--bg)"
      stroke-width="2.6"
      stroke-linecap="round"
      fill="none"
    ></path>
    <path
      d="M18.5 12.5 22 16l-3.5 3.5"
      stroke="var(--bg)"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    ></path>
  </svg>
  <span class="text-[17px] font-semibold tracking-[-0.04em] text-fg">formatoza</span>
</a>
