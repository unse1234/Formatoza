---
import { CATEGORY_LIST, conversionsInCategory } from '~/lib/catalog/registry';
import type { CategoryId } from '~/lib/catalog/types';
interface Props {
  active?: CategoryId;
  label?: string;
}
const { active, label = 'Converter categories' } = Astro.props;
---

<nav aria-label={label} class="-mx-4 overflow-x-auto px-4 scrollbar-thin sm:mx-0 sm:px-0">
  <ul class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
    {CATEGORY_LIST.map((c) => (
      <li>
        <a
          href={`/${c.path}/`}
          aria-current={active === c.id ? 'page' : undefined}
          class:list={[
            'inline-flex h-9 items-center gap-2 rounded-full px-4 text-sm transition-colors',
            active === c.id
              ? 'bg-fg text-on-fg'
              : 'bg-surface text-fg-2 shadow-border hover:bg-hover hover:text-fg',
          ]}
        >
          {c.navLabel}
          <span class:list={['font-mono text-xs', active === c.id ? 'opacity-70' : 'text-fg-3']}>
            {conversionsInCategory(c.id).length}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>
