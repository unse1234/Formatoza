---
/**
 * A single responsive AdSense unit, clearly labelled and visually separated
 * from tool actions. Renders nothing unless ads are configured (or design
 * placeholders are enabled). Must never be placed inside the converter.
 */
import { ADS, type AdPlacement } from '~/config/ads';
import AdSlotPlaceholder from './AdSlotPlaceholder.astro';
interface Props {
  placement: AdPlacement;
  class?: string;
  /** "Advertisement" in the page language. */
  label?: string;
}
const { placement, class: className, label = 'Advertisement' } = Astro.props;
const slot = ADS.slotFor(placement);
const show = Boolean(slot) || ADS.placeholders;
---

{show && (
  <aside class:list={['fz-ad my-10', className]} aria-label={label} data-ad-placement={placement}>
    <p class="mb-2 text-center text-[11px] font-medium tracking-wide text-fg-3 uppercase">
      {label}
    </p>
    {slot ? (
      <div class="min-h-[250px] overflow-hidden rounded-lg">
        <ins
          class="adsbygoogle block"
          style="display:block"
          data-ad-client={ADS.client}
          data-ad-slot={slot}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
      </div>
    ) : (
      <AdSlotPlaceholder placement={placement} />
    )}
  </aside>
)}
