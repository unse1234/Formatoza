---
import type { FaqItem } from '~/lib/catalog/types';
interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}
const { items, title = 'Frequently asked questions', id = 'faq' } = Astro.props;
---

<section aria-labelledby={id}>
  <h2 id={id} class="t-title">
    {title}
  </h2>
  <div class="mt-6 divide-y divide-[var(--border)] rounded-lg bg-surface shadow-border">
    {items.map((f) => (
      <details class="group px-5 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-[15px] font-medium text-fg">
          <h3 class="font-medium">{f.q}</h3>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            class="mt-1 shrink-0 text-fg-3 transition-transform duration-200 group-open:rotate-45"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="-mt-1 pb-5 text-[15px] leading-relaxed text-fg-2">{f.a}</p>
      </details>
    ))}
  </div>
</section>
