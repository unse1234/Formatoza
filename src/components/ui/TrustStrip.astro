---
/**
 * Processing & privacy facts. Only claims that are true for the tool:
 * the "on your device" line is shown only for tools that run locally.
 */
import Icon from './Icon.astro';
import type { BrowserProcessingStatus } from '~/lib/catalog/types';
interface Props {
  processing: BrowserProcessingStatus;
  lazyAssetNote?: string | undefined;
  class?: string;
  /** Localized copy (defaults to English). */
  strings?: {
    deviceTitle: string;
    deviceText: string;
    accountTitle: string;
    accountText: string;
    fastTitle: string;
    fastText: string;
    freeTitle: string;
    freeText: string;
  };
}
const {
  processing,
  lazyAssetNote,
  class: className,
  strings: s = {
    deviceTitle: 'Stays on your device',
    deviceText: 'Files are processed by your browser and never uploaded.',
    accountTitle: 'No account',
    accountText: 'No sign-up, no email, no watermark.',
    fastTitle: 'Fast',
    fastText: 'No upload or queue — conversion starts instantly.',
    freeTitle: 'Free',
    freeText: 'Every tool is free to use, supported by ads.',
  },
} = Astro.props;
const local = processing === 'local' || processing === 'local-lazy-assets';
const items = [
  ...(local ? [{ icon: 'shield' as const, title: s.deviceTitle, text: s.deviceText }] : []),
  { icon: 'user-off' as const, title: s.accountTitle, text: s.accountText },
  { icon: 'bolt' as const, title: s.fastTitle, text: s.fastText },
  { icon: 'gift' as const, title: s.freeTitle, text: s.freeText },
];
---

<div class:list={['rounded-lg bg-surface shadow-border', className]}>
  <ul class="grid divide-y divide-[var(--border)] sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4">
    {items.map((i) => (
      <li class="flex gap-3 p-4">
        <Icon name={i.icon} size={18} class="mt-0.5 shrink-0 text-fg" />
        <div>
          <p class="text-sm font-medium text-fg">{i.title}</p>
          <p class="mt-0.5 text-[13px] leading-snug text-fg-3">{i.text}</p>
        </div>
      </li>
    ))}
  </ul>
  {lazyAssetNote && (
    <p class="flex gap-2 px-4 py-3 text-[13px] text-fg-3 shadow-[0_-1px_0_0_var(--border)]">
      <span class="dot mt-1.5 bg-dot-blue" aria-hidden="true" />
      {lazyAssetNote}
    </p>
  )}
</div>
