---
import FormatPair from './FormatPair.astro';
import type { ConversionMeta } from '~/lib/catalog/types';
interface Props {
  tool: ConversionMeta;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
}
const { tool, compact = false, headingLevel: H = 'h3' } = Astro.props;
---

<a
  href={tool.path}
  class:list={[
    'group flex h-full flex-col rounded-lg bg-surface shadow-border transition-[box-shadow,background-color] duration-150 hover:shadow-large',
    compact ? 'gap-2 p-4' : 'gap-3 p-5',
  ]}
>
  <FormatPair from={tool.source.name} to={tool.target.name} />
  <H class:list={['font-semibold tracking-[-0.02em] text-fg', compact ? 'text-[15px]' : 'text-base']}>{tool.h1}</H>
  {!compact && <p class="text-sm leading-relaxed text-fg-2">{tool.shortDescription}</p>}
  <span class="mt-auto inline-flex items-center gap-1 pt-1 text-[13px] text-fg-3 group-hover:text-accent">
    Open converter
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
  </span>
</a>
