---
/**
 * Localized tool page. One template for every language: copy comes from
 * src/content/localized/{locale}/{slug}.md and src/i18n/pages.ts, the tool is the same
 * converter island as the English page with the page language's UI dictionary.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ConverterShell from '~/components/converter/ConverterShell.tsx';
import PendingFilesScript from '~/components/converter/PendingFilesScript.astro';
import TrustStrip from '~/components/ui/TrustStrip.astro';
import FAQ from '~/components/ui/FAQ.astro';
import FormatPair from '~/components/ui/FormatPair.astro';
import Icon from '~/components/ui/Icon.astro';
import AdSlot from '~/components/ads/AdSlot.astro';
import { toClientConversion } from '~/lib/catalog/registry';
import { formatBytes } from '~/lib/file/format';
import {
  breadcrumbList,
  faqPage,
  graph,
  organization,
  webApplication,
  website,
} from '~/lib/seo/jsonld';
import { SITE } from '~/config/site';
import { LOCALES, localeHomePath, type LocalizedLocaleCode } from '~/i18n/locales';
import { LOCALIZED_PAGES, conversionAlternates } from '~/i18n/registry';
import { getLocalizedPage, relatedLocalized, renderLocalizedBody } from '~/i18n/content';
import { PAGE_STRINGS } from '~/i18n/pages';
import { uiStringsFor } from '~/i18n/ui';
import { fmt } from '~/components/converter/i18n';

export function getStaticPaths() {
  return LOCALIZED_PAGES.map((p) => ({
    params: { locale: p.locale, slug: p.slug },
    props: { ref: p },
  }));
}

const { ref } = Astro.props;
const locale = ref.locale as LocalizedLocaleCode;
const c = ref.meta;
const page = await getLocalizedPage(ref);
const { Content, headings } = await renderLocalizedBody(ref);
const ps = PAGE_STRINGS[locale];
const names = { from: c.source.name, to: c.target.name };
const alternates = conversionAlternates(c.slug);
const english = alternates.find((a) => a.locale === 'en')!;
const related = await Promise.all(relatedLocalized(ref).map((r) => getLocalizedPage(r)));
const home = localeHomePath(locale);
const category = ps.categories[c.category] ?? c.category;

const crumbs = [
  { name: ps.home, path: home },
  { name: page.h1, path: ref.path },
];
const jsonLd = graph(
  organization(),
  website(),
  breadcrumbList(crumbs),
  webApplication(c, {
    path: ref.path,
    name: `${page.h1} — ${SITE.name}`,
    description: page.shortDescription,
    inLanguage: LOCALES[locale].hreflang,
  }),
  faqPage(page.faq, ref.path, LOCALES[locale].hreflang),
);
const toc = [
  { id: 'about', text: fmt(ps.about, names) },
  { id: 'how-to', text: fmt(ps.howTo, names) },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  { id: 'formats', text: fmt(ps.formats, names) },
  { id: 'limits', text: ps.limits.heading },
  { id: 'limitations', text: ps.limitations },
  { id: 'use-cases', text: ps.useCases },
  { id: 'faq', text: ps.faq },
];
const reviewed = new Date(SITE.contentReviewed).toLocaleDateString(ps.intl, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const lazyNote =
  c.from === 'heic'
    ? ps.lazyAsset.heic
    : c.from === 'pdf'
      ? ps.lazyAsset.pdfjs
      : c.to === 'pdf'
        ? ps.lazyAsset.pdfWriter
        : undefined;
const introParas = page.intro.split(/\n\s*\n/);
const L = ps.limits;
const facts: [string, string][] = [
  [L.acceptedInput, c.input.extensions.join(', ') + (c.input.textInput ? L.orPaste : '')],
  [
    L.output,
    `${c.target.name} (${c.output.extension})${c.output.combinesInputs && c.input.multiple ? L.combined : ''}`,
  ],
  [L.filesPerConversion, c.input.multiple ? fmt(L.upTo, { n: c.input.maxFiles }) : L.oneAtATime],
  [L.maxFileSize, fmt(L.perFile, { size: formatBytes(c.input.maxFileBytes) })],
  [L.whereItRuns, L.onDevice],
  [L.cost, L.costValue],
];
---

<BaseLayout
  meta={{
    title: page.title,
    description: page.metaDescription,
    path: ref.path,
    locale,
    alternates,
    imageAlt: page.h1,
  }}
  jsonLd={jsonLd}
  ads
>
  <div class="container-page pt-6 sm:pt-8">
    <Breadcrumbs items={crumbs} label={ps.breadcrumb} />

    <header class="mt-6 max-w-3xl sm:mt-8">
      <p class="t-eyebrow">
        {category} · {c.source.name} → {c.target.name}
      </p>
      <h1 class="t-display mt-3">{page.h1}</h1>
      <p class="mt-4 text-lg leading-relaxed text-fg-2">{page.shortDescription}</p>
    </header>

    <div class="mt-8">
      <ConverterShell
        client:load
        conversion={toClientConversion(c)}
        strings={uiStringsFor(locale, c)}
      />
      <PendingFilesScript />
      <noscript>
        <p class="mt-4 rounded-lg bg-surface p-4 text-sm text-fg-2 shadow-border">{ps.noscript}</p>
      </noscript>
    </div>

    <TrustStrip
      class="mt-4"
      processing={c.browserProcessing}
      lazyAssetNote={lazyNote}
      strings={ps.trust}
    />

    <AdSlot placement="toolAfterConverter" label={ps.ad} />

    <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16">
      <article class="min-w-0">
        <section aria-labelledby="about" class="prose-fz">
          <h2 id="about" class="!mt-0">
            {fmt(ps.about, names)}
          </h2>
          {introParas.map((p) => (
            <p>{p}</p>
          ))}
        </section>

        <section aria-labelledby="how-to" class="mt-12">
          <h2 id="how-to" class="t-title">
            {fmt(ps.howTo, names)}
          </h2>
          <ol class="mt-6 grid gap-3">
            {page.steps.map((s, i) => (
              <li class="flex gap-4 rounded-lg bg-surface p-4 shadow-border">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-fg font-mono text-xs font-medium text-on-fg">
                  {i + 1}
                </span>
                <p class="pt-0.5 text-[15px] leading-relaxed text-fg-2">{s}</p>
              </li>
            ))}
          </ol>
        </section>

        <div class="prose-fz mt-4">
          <Content />
        </div>

        <section aria-labelledby="formats" class="mt-14">
          <h2 id="formats" class="t-title">
            {fmt(ps.formats, names)}
          </h2>
          <div class="prose-fz mt-5">
            <h3 class="!mt-0">{fmt(ps.whatIs, { name: c.source.name })}</h3>
            <p>{page.sourceExplanation}</p>
            <h3>{fmt(ps.whatIs, { name: c.target.name })}</h3>
            <p>{page.targetExplanation}</p>
          </div>
        </section>

        <section aria-labelledby="limits" class="mt-14">
          <h2 id="limits" class="t-title">
            {L.heading}
          </h2>
          <dl class="mt-6 grid overflow-hidden rounded-lg bg-surface text-sm shadow-border sm:grid-cols-2">
            {facts.map(([k, v]) => (
              <div class="flex flex-col gap-1 p-4 shadow-[0_0_0_0.5px_var(--border)]">
                <dt class="text-[13px] text-fg-3">{k}</dt>
                <dd class="font-medium break-words text-fg">{v}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-3 text-[13px] text-fg-3">{L.note}</p>
        </section>

        <section aria-labelledby="limitations" class="mt-14">
          <h2 id="limitations" class="t-title">
            {ps.limitations}
          </h2>
          <ul class="mt-6 grid gap-3">
            {page.limitations.map((l) => (
              <li class="flex gap-3 text-[15px] leading-relaxed text-fg-2">
                <span class="dot mt-2.5 bg-dot-amber" aria-hidden="true" />
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="use-cases" class="mt-14">
          <h2 id="use-cases" class="t-title">
            {ps.useCases}
          </h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {page.useCases.map((u) => (
              <li class="rounded-lg bg-surface p-5 shadow-border">
                <h3 class="text-[15px] font-semibold tracking-[-0.01em] text-fg">{u.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-fg-2">{u.text}</p>
              </li>
            ))}
          </ul>
        </section>

        <AdSlot placement="toolInContent" label={ps.ad} />

        <div class="mt-14">
          <FAQ items={page.faq} title={ps.faq} />
        </div>

        <aside
          class="mt-14 flex gap-4 rounded-lg bg-surface p-5 text-sm text-fg-2 shadow-border"
          aria-labelledby="page-about"
        >
          <Icon name="book" size={18} class="mt-0.5 shrink-0 text-fg" />
          <p id="page-about">
            {fmt(ps.reviewed, { site: SITE.name, date: reviewed })} {ps.editorialLinks}{' '}
            <a class="link" href="/editorial-policy/" hreflang="en">
              {ps.editorialPolicy}
            </a>
            {' · '}
            <a class="link" href="/how-it-works/" hreflang="en">
              {ps.howItWorks}
            </a>
            {' · '}
            <a class="link" href="/contact/" hreflang="en">
              {ps.contact}
            </a>
          </p>
        </aside>
      </article>

      <aside class="hidden lg:block" aria-label={ps.onThisPage}>
        <div class="sticky top-[calc(var(--header-h)+24px)] grid gap-8">
          <nav aria-labelledby="toc-h">
            <p id="toc-h" class="t-eyebrow">
              {ps.onThisPage}
            </p>
            <ul class="mt-3 grid gap-2 text-[13px]">
              {toc.map((t) => (
                <li>
                  <a href={`#${t.id}`} class="text-fg-2 hover:text-fg">
                    {t.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="grid gap-2 text-[13px]">
            <a href={home} class="text-fg-2 hover:text-fg">
              {ps.allTools} →
            </a>
            <a href={english.href} hreflang="en" class="text-fg-2 hover:text-fg">
              {ps.englishVersion} →
            </a>
          </div>
        </div>
      </aside>
    </div>

    <div class="mt-16 grid gap-6">
      {related.length > 0 && (
        <section aria-labelledby="related">
          <h2 id="related" class="t-subtitle">
            {c.reverse && related.some((r) => r.conversion === c.reverse)
              ? fmt(ps.relatedWithReverse, names)
              : ps.related}
          </h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <li>
                <a
                  href={r.path}
                  class="group flex h-full flex-col gap-2 rounded-lg bg-surface p-4 shadow-border transition-[box-shadow,background-color] duration-150 hover:shadow-large"
                >
                  <FormatPair from={r.meta.source.name} to={r.meta.target.name} />
                  <h3 class="text-[15px] font-semibold tracking-[-0.02em] text-fg">{r.h1}</h3>
                  <span class="mt-auto inline-flex items-center gap-1 pt-1 text-[13px] text-fg-3 group-hover:text-accent">
                    {ps.openConverter}
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <p class="text-sm text-fg-2">
        <a class="link" href={home}>
          {ps.allTools}
        </a>
        {' · '}
        <a class="link" href="/" hreflang="en">
          {ps.moreInEnglish}
        </a>
        <span class="lg:hidden">
          {' · '}
          <a class="link" href={english.href} hreflang="en">
            {ps.englishVersion}
          </a>
        </span>
      </p>
    </div>
  </div>
</BaseLayout>
