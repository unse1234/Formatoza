---
/** Localized hub: the home page of a language, listing only the tools that exist in it. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import FormatPair from '~/components/ui/FormatPair.astro';
import Icon from '~/components/ui/Icon.astro';
import TrustStrip from '~/components/ui/TrustStrip.astro';
import { graph, organization, website } from '~/lib/seo/jsonld';
import { absoluteUrl } from '~/config/site';
import { CATEGORY_IDS } from '~/lib/catalog/types';
import { LOCALES, localeHomePath, type LocalizedLocaleCode } from '~/i18n/locales';
import { ACTIVE_LOCALES, homeAlternates, localizedPagesFor } from '~/i18n/registry';
import { getLocalizedPage } from '~/i18n/content';
import { PAGE_STRINGS } from '~/i18n/pages';

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as LocalizedLocaleCode;
const ps = PAGE_STRINGS[locale];
const path = localeHomePath(locale);
const pages = await Promise.all(localizedPagesFor(locale).map((p) => getLocalizedPage(p)));
const groups = CATEGORY_IDS.map((id) => ({
  id,
  name: ps.categories[id] ?? id,
  pages: pages.filter((p) => p.meta.category === id),
})).filter((g) => g.pages.length);

const jsonLd = graph(organization(), website(), {
  '@type': 'CollectionPage',
  '@id': `${absoluteUrl(path)}#page`,
  name: ps.hub.h1,
  description: ps.hub.metaDescription,
  url: absoluteUrl(path),
  inLanguage: LOCALES[locale].hreflang,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: pages.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absoluteUrl(p.path),
      name: p.h1,
    })),
  },
});
---

<BaseLayout
  meta={{
    title: ps.hub.title,
    description: ps.hub.metaDescription,
    path,
    locale,
    alternates: homeAlternates(),
    imageAlt: ps.hub.h1,
  }}
  jsonLd={jsonLd}
>
  <div class="container-page pt-10 sm:pt-16">
    <header class="max-w-3xl">
      <h1 class="t-display">{ps.hub.h1}</h1>
      <p class="mt-4 text-lg leading-relaxed text-fg-2">{ps.hub.intro}</p>
      {ps.hub.test && <p class="mt-3 text-sm text-fg-3">{ps.hub.test}</p>}
    </header>

    <div class="mt-10 grid gap-12">
      {groups.map((g) => (
        <section aria-labelledby={`cat-${g.id}`}>
          <h2 id={`cat-${g.id}`} class="t-title">
            {g.name}
          </h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {g.pages.map((p) => (
              <li>
                <a
                  href={p.path}
                  class="group flex h-full flex-col gap-3 rounded-lg bg-surface p-5 shadow-border transition-[box-shadow,background-color] duration-150 hover:shadow-large"
                >
                  <FormatPair from={p.meta.source.name} to={p.meta.target.name} />
                  <h3 class="text-base font-semibold tracking-[-0.02em] text-fg">{p.h1}</h3>
                  <p class="text-sm leading-relaxed text-fg-2">{p.shortDescription}</p>
                  <span class="mt-auto inline-flex items-center gap-1 pt-1 text-[13px] text-fg-3 group-hover:text-accent">
                    {ps.openConverter}
                    <Icon name="arrow-right" size={14} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <TrustStrip class="mt-14" processing="local" strings={ps.trust} />

    <section aria-labelledby="why" class="mt-14 max-w-3xl">
      <h2 id="why" class="t-title">
        {ps.hub.privacyHeading}
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-fg-2">{ps.hub.privacyText}</p>
      <p class="mt-6 text-sm">
        <a class="link" href="/" hreflang="en">
          {ps.hub.englishCatalog}
        </a>
      </p>
    </section>
  </div>
</BaseLayout>
