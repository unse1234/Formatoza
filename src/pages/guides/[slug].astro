---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import RelatedTools from '~/components/ui/RelatedTools.astro';
import AdSlot from '~/components/ads/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { getConversionMeta } from '~/lib/catalog/registry';
import { article, breadcrumbList, graph, organization, website } from '~/lib/seo/jsonld';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const path = `/guides/${guide.id}/`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: guide.data.h1, path },
];
const tools = guide.data.tools.map(getConversionMeta);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  meta={{
    title: guide.data.title,
    description: guide.data.metaDescription,
    path,
    type: 'article',
    publishedTime: guide.data.published.toISOString(),
    modifiedTime: guide.data.updated.toISOString(),
  }}
  jsonLd={graph(
    organization(),
    website(),
    breadcrumbList(crumbs),
    article({ title: guide.data.h1, description: guide.data.metaDescription, path, published: guide.data.published, updated: guide.data.updated }),
  )}
  ads
>
  <div class="container-page pt-6 sm:pt-8">
    <Breadcrumbs items={crumbs} />
    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_240px] lg:gap-16">
      <article class="min-w-0 max-w-3xl">
        <header>
          <p class="t-eyebrow">Guide</p>
          <h1 class="t-display mt-3">{guide.data.h1}</h1>
          <p class="mt-5 text-lg leading-relaxed text-fg-2">{guide.data.summary}</p>
          <p class="mt-4 text-[13px] text-fg-3">
            By the Formatoza team · Updated <time datetime={guide.data.updated.toISOString().slice(0, 10)}>{fmt(guide.data.updated)}</time>
          </p>
        </header>
        <div class="prose-fz mt-10">
          <Content />
        </div>
        <AdSlot placement="guideInContent" />
      </article>
      <aside class="hidden lg:block" aria-label="Guide navigation">
        <nav class="sticky top-[calc(var(--header-h)+24px)]" aria-labelledby="g-toc">
          <p id="g-toc" class="t-eyebrow">In this guide</p>
          <ul class="mt-3 grid gap-2 text-[13px]">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="text-fg-2 hover:text-fg">{h.text}</a></li>)}
          </ul>
        </nav>
      </aside>
    </div>
    <div class="mt-16"><RelatedTools tools={tools} title="Converters mentioned in this guide" /></div>
  </div>
</BaseLayout>
